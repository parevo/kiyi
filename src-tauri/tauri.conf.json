{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kiyi",
  "version": "../package.json",
  "identifier": "com.parevo.kiyi",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Kiyi",
        "width": 1320,
        "height": 840,
        "minWidth": 920,
        "minHeight": 560,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 16, "y": 21 },
        "backgroundColor": "#101215",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "category": "DeveloperTool",
    "shortDescription": "The database app for everyone",
    "copyright": "© 2026 Parevo",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": { "minimumSystemVersion": "11.0", "signingIdentity": "-" }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDEyNTkzQUE0NDQyRkI2QjkKUldTNXRpOUVwRHBaRWdUSkk0TlBKS0NNeTVmdkV6azhiNEdid1ArK3l4YnlnbXR6Wkg0Uy9hUVoK",
      "endpoints": ["https://github.com/parevo/kiyi/releases/latest/download/latest.json"]
    }
  }
}
